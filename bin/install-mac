#/bin/zsh

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

softwareupdate --install-rosetta

brew bundle
echo "Configuring git"

# install global gitignore
git config --global core.excludesfile $DOTFILES_ROOT/.gitignore_global

echo "Install doom"
git clone --depth 1 https://github.com/doomemacs/doomemacs ~/.config/emacs
~/.config/emacs/bin/doom install

echo "Linking Dotfiles"
rm -rf ./~.doom.d
ln -fs $DOTFILES_ROOT/.doom.d ~/.doom.d
ln -fs $DOTFILES_ROOT/.zshrc ~/.zshrc
ln -fs $DOTFILES_ROOT/.zshenv ~/.zshenv
ln -fs $DOTFILES_ROOT/.zsh_plugins.txt ~/.zsh_plugins.txt
ln -fs $DOTFILES_ROOT/.wezterm.lua ~/.wezterm.lua
mkdir -p ~/.claude/skills
ln -fs $DOTFILES_ROOT/.claude/CLAUDE.md ~/.claude/CLAUDE.md
# anvil (Emacs MCP server) for every Claude Code session; it registers its tools under
# two server-ids, hence two entries (see bin/anvil-mcp).
claude mcp remove anvil --scope user 2>/dev/null || true
claude mcp add-json --scope user anvil \
	"{\"type\":\"stdio\",\"command\":\"$DOTFILES_ROOT/bin/anvil-mcp\"}"
claude mcp remove anvil-emacs-eval --scope user 2>/dev/null || true
claude mcp add-json --scope user anvil-emacs-eval \
	"{\"type\":\"stdio\",\"command\":\"$DOTFILES_ROOT/bin/anvil-mcp\",\"args\":[\"emacs-eval\"]}"
ln -fs $DOTFILES_ROOT/claude/skills/rename-agent-shell-buffer ~/.claude/skills/rename-agent-shell-buffer
claude plugin marketplace add xenodium/emacs-skills
claude plugin install emacs-skills@xenodium-emacs-skills
echo "Done"
